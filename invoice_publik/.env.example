# ========================================================
# INVOICE PUBLIK (CLOUD) — FILE KONFIGURASI ENVIRONMENT (.env)
# ========================================================

# --------------------------------------------------------
# 1. SERVER & PORT
# --------------------------------------------------------
PORT=5175
HOST=0.0.0.0

# --------------------------------------------------------
# 2. SUPABASE POSTGRESQL (CLOUD DATABASE)
# --------------------------------------------------------
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
# Biarkan kosong jika ingin menjalankan mode Mock In-Memory otomatis (tanpa akun Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------
# 3. KEAMANAN & AUTENTIKASI SINKRONISASI
# --------------------------------------------------------
# Secret Key untuk mengamankan API push sync dari laptop POS kasir
# HARUS SAMA dengan SYNC_SECRET_KEY di pos_warung_madura/.env
SYNC_SECRET_KEY=warung_madura_sync_secret_2026

# --------------------------------------------------------
# 4. DEFAULT PROFIL WARUNG (FALLBACK)
# --------------------------------------------------------
DEFAULT_STORE_NAME=Warung Madura Berkah
DEFAULT_STORE_ADDRESS=Jl. Raya Warung Madura No. 24, Buka 24 Jam Non-Stop
DEFAULT_CASHIER_NAME=Cak Mat

# --------------------------------------------------------
# 5. RETENSI & PEMBERSIHAN OTOMATIS STRUK (JAM)
# --------------------------------------------------------
# Struk akan otomatis dihapus dalam durasi jam ini setelah transaksi (default: 12 jam)
INVOICE_RETENTION_HOURS=12
