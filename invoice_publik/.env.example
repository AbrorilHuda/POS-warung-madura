# ========================================================
# INVOICE PUBLIK (CLOUD) — FILE KONFIGURASI ENVIRONMENT (.env)
# Versi: 2.1 — Multi-Tenant SaaS
#
# Salin file ini menjadi .env lalu isi nilai-nilainya.
# Jangan pernah commit file .env ke repository!
# ========================================================

# --------------------------------------------------------
# 1. SERVER & PORT
# --------------------------------------------------------
PORT=5175
HOST=0.0.0.0

# --------------------------------------------------------
# 2. SUPABASE POSTGRESQL (CLOUD DATABASE)
# --------------------------------------------------------
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
# Biarkan kosong jika ingin menjalankan mode Mock In-Memory otomatis (tanpa akun Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------
# 3. URL PUBLIK PLATFORM
# --------------------------------------------------------
# Ganti ke domain production saat domain sudah siap
# Contoh production: https://warungku.my.id
PUBLIC_BASE_URL=http://localhost:5175

# --------------------------------------------------------
# 4. RESEND — EMAIL TRANSAKSIONAL
# --------------------------------------------------------
# Dapatkan API key dari https://resend.com/api-keys
# Digunakan untuk mengirim email kredensial (STORE_CODE + SYNC_SECRET) ke toko baru
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Alamat pengirim — harus verifikasi domain di Resend terlebih dahulu
FROM_EMAIL=noreply@[domain-kamu]

# --------------------------------------------------------
# 5. KONFIGURASI SAAS & TIER
# --------------------------------------------------------
# Harga Pro dalam rupiah (untuk display di landing page /daftar)
PRO_PLAN_PRICE=25000
# Batas invoice gratis per bulan (reset tiap tanggal 1)
FREE_INVOICE_LIMIT=50

# --------------------------------------------------------
# 6. DEFAULT PROFIL WARUNG (FALLBACK — untuk toko pertama/demo)
# --------------------------------------------------------
DEFAULT_STORE_NAME=Nama Toko Kamu
DEFAULT_STORE_ADDRESS=Alamat Toko Kamu
DEFAULT_CASHIER_NAME=Nama Kasir

# --------------------------------------------------------
# 7. RETENSI & PEMBERSIHAN OTOMATIS STRUK (JAM)
# --------------------------------------------------------
# Struk akan otomatis dihapus dalam durasi jam ini setelah transaksi (default: 12 jam)
INVOICE_RETENTION_HOURS=12
