# ========================================================
# POS WARUNG MADURA — FILE KONFIGURASI ENVIRONMENT (.env)
# ========================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Semua konfigurasi di bawah ini dapat diubah sesuai kebutuhan.

# --------------------------------------------------------
# 1. SERVER & PORT
# --------------------------------------------------------
PORT=5174
HOST=0.0.0.0

# --------------------------------------------------------
# 2. DATABASE MYSQL LOKAL (LAPTOP WARUNG)
# --------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pos_warung_madura
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=+07:00

# --------------------------------------------------------
# 3. IDENTITAS & PROFIL WARUNG / TOKO
# --------------------------------------------------------
# Kode unik warung untuk prefix faktur (contoh: WM01 -> WM01-000142)
STORE_CODE=WM01
# Nama warung / minimarket yang tampil di struk dan layar
STORE_NAME=Warung Madura Berkah
# Slogan / tagline warung
STORE_TAGLINE=Buka 24 Jam Non-Stop
# Alamat lengkap warung untuk dicetak di nota & invoice
STORE_ADDRESS=Jl. Raya Warung Madura No. 24, Buka 24 Jam Non-Stop
# Kota lokasi warung
STORE_CITY=Sumenep
# Nama default kasir yang bertugas
CASHIER_DEFAULT_NAME=Cak Mat

# --------------------------------------------------------
# 4. SINKRONISASI CLOUD & INVOICE PUBLIK
# --------------------------------------------------------
# Endpoint API sync invoice publik (aplikasi invoice_publik)
PUBLIC_INVOICE_SYNC_URL=http://127.0.0.1:5175/api/sync

# Secret Key untuk otentikasi kirim data (harus sama dengan SYNC_SECRET_KEY di invoice_publik/.env)
SYNC_SECRET_KEY=warung_madura_sync_secret_2026

# Base URL publik untuk QR Code struk pelanggan
# Kosongkan untuk deteksi otomatis IP LAN / localhost
# Jika sudah dideploy di domain publik, contoh: https://invoice.warungmadura.id
PUBLIC_INVOICE_BASE_URL=
