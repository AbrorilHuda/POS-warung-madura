# ========================================================
# POS WARUNG MADURA — FILE KONFIGURASI ENVIRONMENT (.env)
# ========================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Semua konfigurasi di bawah ini dapat diubah sesuai kebutuhan.

# --------------------------------------------------------
# 1. SERVER & PORT
# --------------------------------------------------------
PORT=5174
HOST=0.0.0.0

# --------------------------------------------------------
# 2. DATABASE MYSQL LOKAL (LAPTOP WARUNG)
# --------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pos_warung_madura
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=+07:00

# --------------------------------------------------------
# 3. IDENTITAS & PROFIL WARUNG / TOKO
# --------------------------------------------------------
# Kode unik warung untuk prefix faktur (harus sama dengan kode saat daftar di platform SaaS)
# Contoh: WM01 -> faktur berformat WM01-000142
STORE_CODE=WM01

# Nama warung / toko yang tampil di struk dan layar pelanggan
STORE_NAME=Warung Madura Berkah

# Slug toko untuk URL struk online publik
# Contoh: warung-madura-berkah -> https://warungku.my.id/warung-madura-berkah/invoice/WM01-000142
STORE_SLUG=warung-madura-berkah

# Slogan / tagline warung
STORE_TAGLINE=Buka 24 Jam Non-Stop

# Alamat lengkap warung untuk dicetak di nota & invoice
STORE_ADDRESS=Jl. Raya Warung Madura No. 24, Buka 24 Jam Non-Stop

# Kota lokasi warung
STORE_CITY=Sumenep

# Nama default kasir yang bertugas
CASHIER_DEFAULT_NAME=Cak Mat

# --------------------------------------------------------
# 4. SINKRONISASI CLOUD & INVOICE PUBLIK (SAAS MULTI-TENANT)
# --------------------------------------------------------
# Endpoint API sync invoice publik (aplikasi invoice_publik)
PUBLIC_INVOICE_SYNC_URL=http://127.0.0.1:5175/api/sync

# Secret Key untuk otentikasi kirim data (didapat saat daftar toko di platform invoice_publik)
# Format: tok_live_...
# Toko baru bisa mendaftar di http://localhost:5175/daftar untuk mendapatkan key ini
SYNC_SECRET_KEY=tok_live_warungmadura_berkah_2026_secret

# Base URL publik untuk QR Code struk pelanggan
# Kosongkan untuk deteksi otomatis IP LAN / localhost port 5175
# Jika sudah online di cloud / domain publik, contoh: https://warungku.my.id
PUBLIC_INVOICE_BASE_URL=
